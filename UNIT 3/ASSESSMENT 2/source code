# ============================================================
# QUESTION 1
# SMART MEDICAL DIAGNOSIS SYSTEM
# Forward Chaining and Backward Chaining
# ============================================================

print("\n============================================================")
print("QUESTION 1 - SMART MEDICAL DIAGNOSIS SYSTEM")
print("============================================================")

# Facts about Patient A
medical_facts = {
    "Fever": True,
    "Cough": True,
    "Breathlessness": True
}

# Medical rules
medical_rules = [
    (["Fever", "Cough"], "Flu"),
    (["Fever", "Rash"], "Measles"),
    (["Cough", "Breathlessness"], "Pneumonia")
]

print("\n--- Forward Chaining ---")

diagnoses = []

for conditions, conclusion in medical_rules:

    if all(medical_facts.get(condition, False)
           for condition in conditions):

        diagnoses.append(conclusion)

        print("Rule fired:",
              " AND ".join(conditions),
              "->",
              conclusion)

        print("Derived fact:", conclusion)

print("\nFinal Diagnoses:")

if len(diagnoses) > 0:
    for diagnosis in diagnoses:
        print("-", diagnosis)
else:
    print("No diagnosis derived.")


# Backward Chaining

print("\n--- Backward Chaining ---")

goal = "Pneumonia"

print("Goal:", goal)

for conditions, conclusion in medical_rules:

    if conclusion == goal:

        print("Using Rule:",
              " AND ".join(conditions),
              "->",
              conclusion)

        print("Sub-goal 1:", conditions[0])
        print("Sub-goal 2:", conditions[1])

        if all(medical_facts.get(condition, False)
               for condition in conditions):

            print("All sub-goals are TRUE.")
            print("Therefore", goal, "is TRUE.")

        else:
            print("Goal cannot be proved.")


