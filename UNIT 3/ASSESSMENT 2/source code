# QUESTION 3
# AGRICULTURAL EXPERT REASONING SYSTEM
# CNF and Resolution Refutation
# ============================================================

print("\n============================================================")
print("QUESTION 3 - AGRICULTURAL EXPERT REASONING SYSTEM")
print("============================================================")

# Initial facts
agri_facts = {
    "SoilDry",
    "CropWheat"
}

print("\nInitial Facts:")

for fact in agri_facts:
    print("-", fact)


# Rule 1

print("\n--- Rule 1 ---")

print("SoilDry -> IrrigationNeeded")

if "SoilDry" in agri_facts:

    agri_facts.add(
        "IrrigationNeeded"
    )

    print("Derived:")
    print("IrrigationNeeded")


# Rule 2

print("\n--- Rule 2 ---")

print(
    "IrrigationNeeded AND CropWheat -> ApplyDripMethod"
)

if (
    "IrrigationNeeded" in agri_facts
    and
    "CropWheat" in agri_facts
):

    agri_facts.add(
        "ApplyDripMethod"
    )

    print("Derived:")
    print("ApplyDripMethod")


# Rule 3

print("\n--- Rule 3 ---")

print(
    "NOT ApplyDripMethod AND CropWheat -> CropAtRisk"
)

if (
    "NOT ApplyDripMethod" in agri_facts
    and
    "CropWheat" in agri_facts
):

    agri_facts.add(
        "CropAtRisk"
    )

    print("Derived:")
    print("CropAtRisk")

else:

    print(
        "Rule 3 cannot be fired because"
    )

    print(
        "NOT ApplyDripMethod is not known."
    )


# CNF

print("\n--- CNF Representation ---")

print("P1 = NOT SoilDry OR IrrigationNeeded")

print(
    "P2 = NOT IrrigationNeeded OR "
    "NOT CropWheat OR ApplyDripMethod"
)

print(
    "P3 = ApplyDripMethod OR "
    "NOT CropWheat OR CropAtRisk"
)

print("P4 = SoilDry")

print("P5 = CropWheat")


# Resolution Refutation

print("\n--- Resolution Refutation ---")

print("Goal: ApplyDripMethod")

print("Negated Goal: NOT ApplyDripMethod")

print("\nResolution Step 1:")

print(
    "NOT SoilDry OR IrrigationNeeded"
)

print("+ SoilDry")

print("Result: IrrigationNeeded")


print("\nResolution Step 2:")

print(
    "NOT IrrigationNeeded OR "
    "NOT CropWheat OR ApplyDripMethod"
)

print("+ IrrigationNeeded")

print(
    "Result: NOT CropWheat OR ApplyDripMethod"
)


print("\nResolution Step 3:")

print(
    "NOT CropWheat OR ApplyDripMethod"
)

print("+ CropWheat")

print("Result: ApplyDripMethod")


print("\nResolution Step 4:")

print("ApplyDripMethod")

print("+ NOT ApplyDripMethod")

print("Result: EMPTY CLAUSE")


print("\nFinal Result:")

print(
    "ApplyDripMethod = TRUE"
)


