import heapq

print("========================================")
print("QUESTION 1 : AI-Powered Drone Delivery (A* Search)")
print("========================================")

graph = {
    'S': [('A', 2), ('B', 5)],
    'A': [('C', 2), ('D', 4)],
    'B': [('D', 1)],
    'C': [('G', 5)],
    'D': [('G', 2)],
    'G': []
}

heuristic = {
    'S': 7,
    'A': 5,
    'B': 3,
    'C': 4,
    'D': 2,
    'G': 0
}

def astar(start, goal):
    pq = [(heuristic[start], 0, start, [start])]
    visited = set()

    while pq:
        f, g, node, path = heapq.heappop(pq)

        if node == goal:
            return path, g

        if node in visited:
            continue

        visited.add(node)

        for next_node, cost in graph[node]:
            new_g = g + cost
            new_f = new_g + heuristic[next_node]
            heapq.heappush(pq, (new_f, new_g, next_node, path + [next_node]))

path, cost = astar('S', 'G')
print("Path:", " -> ".join(path))
print("Cost:", cost)


