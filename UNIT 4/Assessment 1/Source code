import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
from sklearn.linear_model import LogisticRegression
from imblearn.over_sampling import SMOTE


# ==================================================
# TASK 1 - DATA PREPARATION
# ==================================================

print("========================================")
print("TASK 1 - DATA PREPARATION")
print("========================================")

# Load dataset
data = pd.read_csv("diabetes.csv")

# Add column names
data.columns = [
    "Pregnancies",
    "Glucose",
    "BloodPressure",
    "SkinThickness",
    "Insulin",
    "BMI",
    "DiabetesPedigreeFunction",
    "Age",
    "Outcome"
]

print("\nDataset loaded successfully!")
print("\nFirst 5 records:")
print(data.head())

print("\nDataset size:")
print(data.shape)


# Features and target
X = data.drop("Outcome", axis=1)
y = data["Outcome"]

print("\nTarget variable: Outcome")
print("1 = Diabetic")
print("0 = Non-Diabetic")


# Replace zero values with median
columns = [
    "Glucose",
    "BloodPressure",
    "SkinThickness",
    "Insulin",
    "BMI"
]

for column in columns:
    data[column] = data[column].replace(0, np.nan)
    data[column] = data[column].fillna(data[column].median())


# Recreate X after preprocessing
X = data.drop("Outcome", axis=1)
y = data["Outcome"]


# ==================================================
# 70:30 SPLIT
# ==================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.30,
    random_state=42,
    stratify=y
)

print("\nTraining records:", len(X_train))
print("Testing records :", len(X_test))


# ==================================================
# NORMALISATION
# ==================================================

scaler = StandardScaler()

X_train = scaler.fit_transform(X_train)
X_test = scaler.transform(X_test)

print("\nNormalization completed.")


# ==================================================
# SMOTE
# ==================================================

print("\nClass distribution before SMOTE:")
print(y_train.value_counts())

smote = SMOTE(random_state=42)

X_train, y_train = smote.fit_resample(
    X_train,
    y_train
)

print("\nClass distribution after SMOTE:")
print(pd.Series(y_train).value_counts())


# ==================================================
# TASK 2 - DECISION TREE
# ==================================================

print("\n========================================")
print("TASK 2 - DECISION TREE")
print("========================================")

tree = DecisionTreeClassifier(
    criterion="gini",
    random_state=42
)

tree.fit(X_train, y_train)

tree_prediction = tree.predict(X_test)


# Evaluation
accuracy = accuracy_score(y_test, tree_prediction)
precision = precision_score(y_test, tree_prediction)
recall = recall_score(y_test, tree_prediction)
f1 = f1_score(y_test, tree_prediction)


print("\nDecision Tree Results")

print("Accuracy :", round(accuracy, 4))
print("Precision:", round(precision, 4))
print("Recall   :", round(recall, 4))
print("F1 Score :", round(f1, 4))


# False Negatives
from sklearn.metrics import confusion_matrix

cm = confusion_matrix(y_test, tree_prediction)

print("\nConfusion Matrix:")
print(cm)

tn, fp, fn, tp = cm.ravel()

print("\nFalse Negatives:", fn)


# Feature importance
importance = pd.DataFrame({
    "Feature": data.drop("Outcome", axis=1).columns,
    "Importance": tree.feature_importances_
})

importance = importance.sort_values(
    by="Importance",
    ascending=False
)

print("\nDecision Tree Feature Importance:")
print(importance)

print("\nTop 3 Decision Tree Predictors:")

for feature in importance.head(3)["Feature"]:
    print(feature)


# ==================================================
# TASK 2(c) - POST PRUNING
# ==================================================

print("\n========================================")
print("POST PRUNING")
print("========================================")

pruned_tree = DecisionTreeClassifier(
    criterion="gini",
    max_depth=4,
    random_state=42
)

pruned_tree.fit(X_train, y_train)

pruned_prediction = pruned_tree.predict(X_test)

pruned_accuracy = accuracy_score(
    y_test,
    pruned_prediction
)

print("Pre-pruning Accuracy :", round(accuracy, 4))
print("Post-pruning Accuracy:", round(pruned_accuracy, 4))


# ==================================================
# TASK 3 - LOGISTIC REGRESSION
# ==================================================

print("\n========================================")
print("TASK 3 - LOGISTIC REGRESSION")
print("========================================")

logistic = LogisticRegression(
    max_iter=1000,
    random_state=42
)

logistic.fit(X_train, y_train)

logistic_prediction = logistic.predict(X_test)

logistic_probability = logistic.predict_proba(X_test)[:, 1]


log_accuracy = accuracy_score(
    y_test,
    logistic_prediction
)

log_precision = precision_score(
    y_test,
    logistic_prediction
)

log_recall = recall_score(
    y_test,
    logistic_prediction
)

log_f1 = f1_score(
    y_test,
    logistic_prediction
)

from sklearn.metrics import roc_auc_score

log_auc = roc_auc_score(
    y_test,
    logistic_probability
)


print("\nLogistic Regression Results")

print("Accuracy :", round(log_accuracy, 4))
print("Precision:", round(log_precision, 4))
print("Recall   :", round(log_recall, 4))
print("F1 Score :", round(log_f1, 4))
print("AUC-ROC  :", round(log_auc, 4))


# ==================================================
# TASK 3(b) - LOGISTIC FEATURE IMPORTANCE
# ==================================================

log_importance = pd.DataFrame({
    "Feature": data.drop("Outcome", axis=1).columns,
    "Importance": abs(logistic.coef_[0])
})

log_importance = log_importance.sort_values(
    by="Importance",
    ascending=False
)

print("\nLogistic Regression Feature Importance:")
print(log_importance)

print("\nTop 3 Logistic Regression Predictors:")

for feature in log_importance.head(3)["Feature"]:
    print(feature)


# ==================================================
# TASK 4 - Q LEARNING
# ==================================================

print("\n========================================")
print("TASK 4 - Q LEARNING")
print("========================================")

states = [
    "Low Risk",
    "Moderate Risk",
    "High Risk",
    "Improved"
]

actions = [
    "Diet",
    "Exercise",
    "Medication",
    "Monitor"
]

# Q-table
Q = np.zeros((len(states), len(actions)))

alpha = 0.5
gamma = 0.9
epsilon = 0.1


# Reward table
rewards = np.array([
    [5, 5, -2, 2],
    [6, 7, 4, 1],
    [5, 6, 8, -3],
    [4, 5, -2, 3]
])


# State transition table
next_state = np.array([
    [3, 3, 0, 0],
    [3, 3, 2, 1],
    [1, 1, 1, 2],
    [3, 3, 1, 3]
])


# ==================================================
# TRAIN FOR 5 EPISODES
# ==================================================

for episode in range(5):

    state = 2

    print("\nEpisode", episode + 1)

    for step in range(5):

        # Choose action
        if np.random.random() < epsilon:
            action = np.random.randint(4)
        else:
            action = np.argmax(Q[state])

        old_q = Q[state, action]

        reward = rewards[state, action]

        new_state = next_state[state, action]

        # Q-learning formula
        Q[state, action] = old_q + alpha * (
            reward
            + gamma * np.max(Q[new_state])
            - old_q
        )

        print(
            "State:", states[state],
            "| Action:", actions[action],
            "| Reward:", reward,
            "| New Q:",
            round(Q[state, action], 2)
        )

        state = new_state


# ==================================================
# FINAL Q TABLE
# ==================================================

print("\nFinal Q-Table:")

print(
    pd.DataFrame(
        Q,
        index=states,
        columns=actions
    ).round(2)
)


# ==================================================
# FINAL POLICY
# ==================================================

print("\nFinal Learned Policy:")

for i in range(len(states)):

    best_action = actions[np.argmax(Q[i])]

    print(
        states[i],
        "->",
        best_action
    )


print("\n========================================")
print("ALL TASKS COMPLETED")
print("========================================")
