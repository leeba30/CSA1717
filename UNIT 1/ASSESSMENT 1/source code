# QUESTION 3 : EIGHT QUEENS PROBLEM USING BACKTRACKING
# ==========================================================

N = 8

board = [[0 for i in range(N)] for j in range(N)]


def print_board():

    for i in range(N):

        for j in range(N):

            if board[i][j] == 1:
                print("Q", end=" ")

            else:
                print(".", end=" ")

        print()



def is_safe(row, col):

    for i in range(col):

        if board[row][i] == 1:
            return False


    i = row
    j = col

    while i >= 0 and j >= 0:

        if board[i][j] == 1:
            return False

        i -= 1
        j -= 1


    i = row
    j = col

    while i < N and j >= 0:

        if board[i][j] == 1:
            return False

        i += 1
        j -= 1


    return True



def solve_queens(col):

    if col >= N:
        return True


    for row in range(N):

        if is_safe(row, col):

            board[row][col] = 1

            if solve_queens(col + 1):
                return True

            board[row][col] = 0


    return False



if solve_queens(0):
    print_board()



