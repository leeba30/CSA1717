# QUESTION 4 : OLA CAB BOOKING AGENT
# ==========================================================

class OlaCabAgent:

    def __init__(self):

        self.cabs = {
            "Cab101": 3,
            "Cab102": 5,
            "Cab103": 2,
            "Cab104": 7
        }

        self.rate = 15


    def find_nearest_cab(self):

        cab = min(self.cabs, key=self.cabs.get)

        return cab, self.cabs[cab]


    def calculate_fare(self, distance):

        return distance * self.rate


    def book_cab(self):

        cab, distance = self.find_nearest_cab()

        trip = float(input("Enter Trip Distance: "))

        fare = self.calculate_fare(trip)

        print("Cab:", cab)
        print("Fare:", fare)


agent = OlaCabAgent()
agent.book_cab()



