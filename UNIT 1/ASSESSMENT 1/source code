# QUESTION 2 : MARS ROVER INTELLIGENCE AGENT
# ==========================================================

class MarsRover:

    def __init__(self):

        self.position = [0, 0]
        self.goal = [4, 4]
        self.obstacles = [(1, 2), (2, 2), (3, 1)]


    def sense_environment(self):

        if tuple(self.position) in self.obstacles:
            return "Obstacle"

        elif self.position == self.goal:
            return "Goal"

        else:
            return "Clear"


    def take_action(self, status):

        if status == "Obstacle":
            self.position[1] += 1

        elif status == "Clear":

            if self.position[0] < self.goal[0]:
                self.position[0] += 1

            elif self.position[1] < self.goal[1]:
                self.position[1] += 1


    def start(self):

        while self.position != self.goal:

            status = self.sense_environment()

            if status == "Goal":
                break

            self.take_action(status)

        print("Final Position:", self.position)


rover = MarsRover()
rover.start()



